// Cloudflare Workers settings for bs2.ca (no build step).
// Static pages are served from ./; worker/email.js also handles events@ and bills@ email.
{
  "name": "bs2-website",
  "main": "worker/email.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./", "binding": "ASSETS", "html_handling": "auto-trailing-slash" }
}
